# Application Configuration
NODE_ENV=development
PORT=4004
FRONTEND_URL=http://localhost:3004

# Security & Authentication
JWT_SECRET=studyo_lms_super_secure_jwt_secret_key_2026_xyz
JWT_EXPIRES_IN=24h

# Database (PostgreSQL default for Docker, SQLite compatible for isolated tests)
DATABASE_URL=postgresql://studyo_user:studyo_secure_password@localhost:5435/studyo_lms_db?schema=public

# In-memory Cache & Queue
REDIS_URL=redis://localhost:6382

# Media Object Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secure_password
S3_BUCKET_NAME=studyo-lms-course-media

# Local Test Email Sink (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1028
EMAIL_FROM=notifications@studyo-lms.local
