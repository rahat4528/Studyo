# Application Configuration
NODE_ENV=development
PORT=4003
FRONTEND_URL=http://localhost:3003

# Security & Authentication
JWT_SECRET=studyo_course_super_secure_jwt_secret_key_2026_xyz
JWT_EXPIRES_IN=24h

# Database (PostgreSQL default for Docker, SQLite compatible for isolated tests)
DATABASE_URL=postgresql://studyo_user:studyo_secure_password@localhost:5434/studyo_online_course_db?schema=public

# In-memory Cache & Queue
REDIS_URL=redis://localhost:6381

# Media Object Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secure_password
S3_BUCKET_NAME=studyo-course-media

# Payment Webhook Secret
PAYMENT_WEBHOOK_SECRET=whsec_studyo_course_platform_signature_secret_2026

# Local Test Email Sink (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1027
EMAIL_FROM=notifications@studyo-course.local
