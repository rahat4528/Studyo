datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  AUTHOR
  ADMINISTRATOR
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Verdict {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
  OUTPUT_LIMIT_EXCEEDED
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  fullName     String
  role         Role           @default(STUDENT)
  xp           Int            @default(0)
  currentStreak Int           @default(0)
  longestStreak Int           @default(0)
  lastActiveDate DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  submissions  Submission[]
  badges       UserBadge[]
  certificates Certificate[]
  activityLogs ActivityLog[]

  @@map("users")
}

model Track {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  description String
  orderIndex  Int
  createdAt   DateTime  @default(now())

  chapters    Chapter[]
  certificates Certificate[]

  @@map("tracks")
}

model Chapter {
  id          String      @id @default(uuid())
  trackId     String
  title       String
  orderIndex  Int
  track       Track       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  challenges  Challenge[]

  @@map("chapters")
}

model Challenge {
  id             String      @id @default(uuid())
  chapterId      String
  title          String
  slug           String      @unique
  difficulty     Difficulty  @default(EASY)
  xpReward       Int         @default(50)
  description    String
  starterCode    Json        // language -> code template
  solutionCode   Json?       // reference solution
  timeLimitMs    Int         @default(3000)
  memoryLimitMb  Int         @default(128)
  orderIndex     Int

  chapter        Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  testCases      TestCase[]
  hints          Hint[]
  submissions    Submission[]

  @@map("challenges")
}

model TestCase {
  id          String    @id @default(uuid())
  challengeId String
  input       String
  expected    String
  isPublic    Boolean   @default(false)
  orderIndex  Int

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@map("test_cases")
}

model Hint {
  id          String    @id @default(uuid())
  challengeId String
  content     String
  orderIndex  Int
  xpCost      Int       @default(10)

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@map("hints")
}

model Submission {
  id             String    @id @default(uuid())
  challengeId    String
  userId         String
  language       String
  code           String
  verdict        Verdict   @default(PENDING)
  executionTimeMs Int?
  memoryUsedBytes Int?
  passedTests    Int       @default(0)
  totalTests     Int       @default(0)
  errorMessage   String?
  stdout         String?
  createdAt      DateTime  @default(now())

  challenge      Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("submissions")
}

model Badge {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  description String
  icon        String
  xpBonus     Int         @default(100)

  userBadges  UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  count     Int      @default(1)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("activity_logs")
}

model Certificate {
  id               String   @id @default(uuid())
  userId           String
  trackId          String
  verificationCode String   @unique
  recipientName    String
  trackTitle       String
  issuedAt         DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track            Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@map("certificates")
}
