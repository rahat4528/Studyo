# Application Configuration
NODE_ENV=development
PORT=4001
FRONTEND_URL=http://localhost:3000

# Security & Authentication
JWT_SECRET=studyo_quiz_super_secure_jwt_secret_key_2026_xyz
JWT_EXPIRES_IN=24h

# Database (PostgreSQL default for Docker, SQLite compatible for isolated tests)
